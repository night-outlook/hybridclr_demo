{
  "schemaVersion": 1,
  "kind": "H1LocalDiagnosticBatch",
  "minimumFreeGiB": 10,
  "tasks": [
    {
      "id": "source-inspection",
      "kind": "python",
      "argv": [
        "${python}",
        "Tools/AssemblyShadow/shadow_tools.py",
        "pins",
        "--project",
        "${candidate}"
      ],
      "cwd": "${candidate}",
      "timeoutSec": 600,
      "requires": [],
      "environment": {
        "PYTHONPATH": "${candidate}/Tools/AssemblyShadow"
      },
      "validator": "exit-code",
      "minimumTests": 1
    },
    {
      "id": "D02-owner",
      "kind": "python",
      "argv": [
        "${python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "Tools/AssemblyShadow/tests",
        "-p",
        "test_h1_m02_owner.py",
        "-v"
      ],
      "cwd": "${candidate}",
      "timeoutSec": 600,
      "requires": [
        "source-inspection"
      ],
      "environment": {
        "PYTHONPATH": "${candidate}/Tools/AssemblyShadow"
      },
      "validator": "unittest",
      "minimumTests": 15
    },
    {
      "id": "D02-normal-cli",
      "kind": "python",
      "argv": [
        "${python}",
        "Tools/AssemblyShadow/verify-m02-results.py",
        "--check-reflection-config",
        "ProjectSettings/AssemblyShadowReflectionBindings.json",
        "--require-h1-witness"
      ],
      "cwd": "${candidate}",
      "timeoutSec": 600,
      "requires": [
        "D02-owner"
      ],
      "environment": {
        "PYTHONPATH": "${candidate}/Tools/AssemblyShadow"
      },
      "validator": "exit-code",
      "minimumTests": 1
    },
    {
      "id": "D01-pdb-tests",
      "kind": "unity",
      "cwd": "${candidate}",
      "unityProject": "${candidate}",
      "timeoutSec": 1800,
      "requires": [
        "source-inspection"
      ],
      "environment": {
        "ASSEMBLY_SHADOW_ILPP_FAILURE_ROOT": "${TASK_DIR}/captures"
      },
      "validator": "nunit",
      "minimumTests": 19,
      "nunitXml": "${TASK_DIR}/tests.xml",
      "argv": [
        "${unity}",
        "-batchmode",
        "-nographics",
        "-projectPath",
        "${candidate}",
        "-runTests",
        "-testPlatform",
        "EditMode",
        "-testFilter",
        "ReflectionPdb",
        "-testResults",
        "${TASK_DIR}/tests.xml",
        "-logFile",
        "${TASK_DIR}/unity.log"
      ]
    },
    {
      "id": "D01-layout",
      "kind": "unity",
      "cwd": "${candidate}",
      "unityProject": "${candidate}",
      "timeoutSec": 1800,
      "requires": [
        "source-inspection"
      ],
      "environment": {
        "ASSEMBLY_SHADOW_ILPP_FAILURE_ROOT": "${TASK_DIR}/captures"
      },
      "validator": "nunit",
      "minimumTests": 1,
      "nunitXml": "${TASK_DIR}/tests.xml",
      "argv": [
        "${unity}",
        "-batchmode",
        "-nographics",
        "-projectPath",
        "${candidate}",
        "-runTests",
        "-testPlatform",
        "EditMode",
        "-testFilter",
        "AssemblyShadowDemo.EditorTests.M05EditorEvidenceTests.LayoutFixtureUsesPublicPlayerCompilerWithUnchangedSerializedFields",
        "-testResults",
        "${TASK_DIR}/tests.xml",
        "-logFile",
        "${TASK_DIR}/unity.log"
      ]
    },
    {
      "id": "D01-initializer",
      "kind": "unity",
      "cwd": "${candidate}",
      "unityProject": "${candidate}",
      "timeoutSec": 1800,
      "requires": [
        "source-inspection"
      ],
      "environment": {
        "ASSEMBLY_SHADOW_ILPP_FAILURE_ROOT": "${TASK_DIR}/captures"
      },
      "validator": "nunit",
      "minimumTests": 1,
      "nunitXml": "${TASK_DIR}/tests.xml",
      "argv": [
        "${unity}",
        "-batchmode",
        "-nographics",
        "-projectPath",
        "${candidate}",
        "-runTests",
        "-testPlatform",
        "EditMode",
        "-testFilter",
        "AssemblyShadowDemo.EditorTests.R01FailureFixturesTests.InitializerThrowCompilerShapeIsIsolated",
        "-testResults",
        "${TASK_DIR}/tests.xml",
        "-logFile",
        "${TASK_DIR}/unity.log"
      ]
    },
    {
      "id": "python-full",
      "kind": "python",
      "argv": [
        "${python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "Tools/AssemblyShadow/tests",
        "-v"
      ],
      "cwd": "${candidate}",
      "timeoutSec": 600,
      "requires": [
        "source-inspection"
      ],
      "environment": {
        "PYTHONPATH": "${candidate}/Tools/AssemblyShadow"
      },
      "validator": "unittest",
      "minimumTests": 1
    },
    {
      "id": "editor-full",
      "kind": "unity",
      "cwd": "${candidate}",
      "unityProject": "${candidate}",
      "timeoutSec": 1800,
      "requires": [
        "D01-pdb-tests",
        "D01-layout",
        "D01-initializer",
        "D02-owner"
      ],
      "environment": {
        "ASSEMBLY_SHADOW_ILPP_FAILURE_ROOT": "${TASK_DIR}/captures"
      },
      "validator": "nunit",
      "minimumTests": 1,
      "nunitXml": "${TASK_DIR}/tests.xml",
      "argv": [
        "${unity}",
        "-batchmode",
        "-nographics",
        "-projectPath",
        "${candidate}",
        "-runTests",
        "-testPlatform",
        "EditMode",
        "-testFilter",
        "AssemblyShadow",
        "-testResults",
        "${TASK_DIR}/tests.xml",
        "-logFile",
        "${TASK_DIR}/unity.log"
      ]
    }
  ],
  "humanGatePassed": false,
  "mayEnterR02": false
}
